# ==============================================
# AI Multi-Step Content Agent - Environment Config
# ==============================================

# Google Gemini API Key (Required for live AI generation)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily AI Search API Key (Required for live web research)
# Get 1,000 free searches/month at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# AI Model Configuration (Optional, defaults to gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# Application Environment
NODE_ENV=development
